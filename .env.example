# Sin autenticación: usar solamente en localhost o detrás de control de acceso.
AUTH_ENABLED=false
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=
AZURE_AD_TENANT_ID=
DATA_DIR=./data
MAX_SNAPSHOT_BYTES=10485760
BACKUP_KEEP=10
# Opcional: 64 caracteres hexadecimales aleatorios (32 bytes AES-256).
BACKUP_ENCRYPTION_KEY=
NEXT_TELEMETRY_DISABLED=1
LOCAL_FOLDER_ENABLED=true
SERVER_STORAGE_ENABLED=true
GOOGLE_DRIVE_ENABLED=false
ONEDRIVE_ENABLED=false
SBOBY_PI_SHARE_ENABLED=false
CUSTOM_ENDPOINTS_ENABLED=false
GRAPH_EDGE_CREATION_BY_DRAG=false
AVATARS_ENABLED=false
CUSTOM_FIELDS_ENABLED=true
